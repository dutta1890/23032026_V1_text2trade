      ],
      "risk_management": {}
    },
    "expected": {
      "success": true,
      "total_trades_min": 1,
      "total_trades_max": 10,
      "win_rate_min": 0,
      "win_rate_max": 100,
      "notes": "Low-frequency strategy. Expects 1-5 trades over 3 years on RELIANCE daily."
    }
  },
